{
  "name": "zack-cook",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "npm run art:check && npm run themes:check && next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts && node --experimental-test-module-mocks --import tsx --test tests/*.test.mts",
    "add:folly": "node scripts/add-folly.mjs",
    "themes:build": "node scripts/build-theme-tokens.mjs",
    "themes:check": "node scripts/build-theme-tokens.mjs --check",
    "art:build": "node scripts/build-art-assets.mjs",
    "art:check": "node scripts/build-art-assets.mjs --check"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/fraunces": "5.3.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "next": "16.3.8",
    "posthog-js": "1.438.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
