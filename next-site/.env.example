# Local: http://127.0.0.1:3000. Preview: the stable Vercel branch URL.
SITE_URL=http://127.0.0.1:3000
SITE_LIVE=false

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SERVER ONLY. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Owner-only admin/comment tools.
ZACK_ADMIN_EMAIL=
GOOGLE_AUTH_ENABLED=false
FACEBOOK_AUTH_ENABLED=false
EMAIL_OTP_ENABLED=false

# Book launch UI and submission endpoint. Disable and redeploy to pause signups;
# subscriber records and browser-local preferences remain intact.
NEXT_PUBLIC_BOOK_LAUNCH_ENABLED=false
# Server only, independent random secret of at least 32 characters.
BOOK_LAUNCH_RATE_LIMIT_KEY=

# Privacy-first aggregate analytics. Enabled only for trusted US requests;
# browser/local opt-out, GPC, and DNT always take precedence.
BOOK_ANALYTICS_ENABLED=false
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Be Brave anti-bot + anonymous identity security.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Long-lived server-only random secrets, at least 32 characters.
BEBRAVE_HMAC_KEY=
BEBRAVE_CACHE_HMAC_KEY=
