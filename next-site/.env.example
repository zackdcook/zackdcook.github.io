# Local: http://127.0.0.1:3000. Preview: the stable Vercel branch URL.
SITE_URL=http://127.0.0.1:3000
# Keep false until the public launch. Use false in every Preview environment.
SITE_LIVE=false

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SERVER ONLY. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ZACK_ADMIN_EMAIL=
SPOTIFY_CLIENT_ID=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/spotify/callback
# A randomly generated 32-byte key encoded as 64 hexadecimal characters.
INTEGRATION_ENCRYPTION_KEY=
GOOGLE_AUTH_ENABLED=false
FACEBOOK_AUTH_ENABLED=false
# Enable only after configuring SMTP and the OTP email template in Supabase.
EMAIL_OTP_ENABLED=false

# Optional external newsletter signup and Spotify playlist URLs.
NEXT_PUBLIC_SUBSCRIBE_URL=
NEXT_PUBLIC_SPOTIFY_PLAYLIST_URL=

# Guestbook/shoutouts stay closed until all setup and moderation checks pass.
PUBLIC_SUBMISSIONS_ENABLED=false
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Server-only random secret, at least 32 characters. Never use a public key here.
SUBMISSION_HMAC_KEY=
# Free notification sender; daily volume is additionally capped at 20 in SQL.
RESEND_API_KEY=
SUBMISSION_EMAIL_FROM=
