# Local: http://127.0.0.1:3000. Preview: the stable Vercel branch URL.
SITE_URL=http://127.0.0.1:3000
SITE_LIVE=false

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SERVER ONLY. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Owner-only admin/comment tools.
ZACK_ADMIN_EMAIL=
GOOGLE_AUTH_ENABLED=false
FACEBOOK_AUTH_ENABLED=false
EMAIL_OTP_ENABLED=false

# Optional external newsletter signup.
NEXT_PUBLIC_SUBSCRIBE_URL=

# Be Brave anti-bot + anonymous identity security.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Long-lived server-only random secrets, at least 32 characters.
BEBRAVE_HMAC_KEY=
BEBRAVE_CACHE_HMAC_KEY=

# Preview-only Be Brave sandbox.
# Project ref must match NEXT_PUBLIC_SUPABASE_URL.
BEBRAVE_TEST_MODE=false
BEBRAVE_TEST_PROJECT_REF=
